# Copia este archivo como .env.local y completa los valores.
# Firebase: consola de Firebase → Configuración del proyecto → Tus apps → App web.
# Estos valores NO son secretos (van al navegador); la seguridad la dan las reglas de Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Cesium ion (gratis): https://ion.cesium.com → Access Tokens. Restringirlo al dominio de Vercel.
VITE_CESIUM_TOKEN=
